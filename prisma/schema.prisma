generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  password     String
  balance      Float     @default(0.0)
  otp          String?
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  apiKeys      ApiKey[]
  products     Product[] @relation("ProductOwner")
  purchases    Product[] @relation("ProductBuyer")
  checkouts    Checkout[] @relation("CheckoutBuyer")
  sales        Checkout[] @relation("CheckoutSeller")
}


model ApiKey {
  id        String   @id @default(uuid())
  name      String
  key       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [id])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  mainImage   String?
  images      String[]
  brand       String
  price       Float
  status      String   @default("for_sale") // 'for_sale' or 'sold'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId Int
  owner   User @relation("ProductOwner", fields: [ownerId], references: [id])

  buyerId Int?
  buyer   User? @relation("ProductBuyer", fields: [buyerId], references: [id])

  checkout Checkout?
}

model Checkout {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  product   Product  @relation(fields: [productId], references: [id])

  buyerId Int
  buyer   User @relation("CheckoutBuyer", fields: [buyerId], references: [id])

  sellerId Int
  seller   User @relation("CheckoutSeller", fields: [sellerId], references: [id])

  amount    Float
  status    String   @default("completed")
  createdAt DateTime @default(now())
}